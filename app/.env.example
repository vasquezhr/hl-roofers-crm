# Copy this file to ".env" (same folder) and edit it. The .env file is never put in git.

# ----- On your own PC, for trying the app -----
DEBUG=True

# ----- On the server, use these instead -----
# DEBUG=False
# SECRET_KEY=put-a-long-random-string-here
# ALLOWED_HOSTS=app.handlroofers.com
# CSRF_TRUSTED_ORIGINS=https://app.handlroofers.com
# DB_NAME=hlcrm
# DB_USER=hlcrm
# DB_PASSWORD=the-database-password
# DB_HOST=127.0.0.1
# DB_PORT=5432

# ----- Optional, on the PC or the server -----
# The first number of each new year (26-101, 26-102, ...). To carry on from numbers already used
# this year, set the last number used in the admin site instead (Number sequences).
# FIRST_JOB_NUMBER=101

# Apple Notes folders that are never imported, separated by commas. This is what the import page
# starts with; the administrator can change the list each time a file is uploaded.
# IMPORT_SKIP_FOLDERS=Passwords and accounts
