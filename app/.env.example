# Copy this file to ".env" (same folder) and edit it. The .env file is never put in git.

# ----- On your own PC, for trying the app -----
DEBUG=True

# ----- On the server, use these instead -----
# DEBUG=False
# SECRET_KEY=put-a-long-random-string-here
# ALLOWED_HOSTS=app.handlroofers.com
# CSRF_TRUSTED_ORIGINS=https://app.handlroofers.com
# DB_NAME=hlcrm
# DB_USER=hlcrm
# DB_PASSWORD=the-database-password
# DB_HOST=127.0.0.1
# DB_PORT=5432

# ----- Email (proposals, invoices, summaries) -----
# Without EMAIL_HOST the app cannot send email: on your PC it writes each email to the server window instead.
# For a Gmail mailbox: smtp.gmail.com, port 587, and an "app password" made in the Google account (not the normal password).
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=the-mailbox@example.com
# EMAIL_HOST_PASSWORD=the-app-password
# EMAIL_FROM=H & L Roofers <the-mailbox@example.com>

# The app's own web address, used in the links that go out in emails (the customer's Accept page).
# SITE_URL=https://app.handlroofers.com

# ----- The website's request form -----
# The website sends each request to /leads/in/ with this key. Without a key, that address is switched off.
# LEAD_FORM_KEY=a-long-random-word
# LEAD_FORM_ORIGIN=https://www.example.com

# ----- Where the business is, and its work week -----
# Leave these out for H & L: its values are the defaults shown here. Another business sets its own.
# The time zone, as a name from the time zone list: America/New_York, America/Chicago, America/Denver, America/Los_Angeles, ...
# TIME_ZONE=America/New_York
# The work days, with commas. A day off can still be booked by hand, with "Work on a day off".
# WORK_DAYS=mon,tue,wed,thu,fri
# The state a new address starts with, and the state's name as notes may spell it out.
# STATE=VA
# STATE_NAME=Virginia
# For the Apple Notes import: the first digits of the business's ZIP codes, and the towns it knows when a note gives
# a town with no state or ZIP code (empty: the towns around Richmond, while STATE is VA).
# ZIP_STARTS=20,21,22,23,24
# IMPORT_TOWNS=
# More words that mean a note is about the work, with commas. The import already knows roofing words in English and Spanish.
# IMPORT_WORK_WORDS=

# ----- Optional, on the PC or the server -----
# The first number of each new year (26-101, 26-102, ...). To carry on from numbers already used
# this year, set the last number used in the admin site instead (Number sequences).
# FIRST_JOB_NUMBER=101

# Apple Notes folders that are never imported, separated by commas. This is what the import page
# starts with; the administrator can change the list each time a file is uploaded.
# IMPORT_SKIP_FOLDERS=Passwords and accounts

# Photos and files added to jobs and accounts. Leave empty on a PC (they go in the "media" folder next to manage.py).
# On the server, a folder the backups include, for example: MEDIA_ROOT=D:\crm-files
MEDIA_ROOT=
